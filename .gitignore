# Data travels via GitHub Release asset, not as a git blob (two files here are over GitHub's
# 100MB hard per-blob limit: btcusdt_spot_1m_clean.parquet at 201MB, binance_btcusdtperp_1m.parquet
# at 119MB). A cloud run fetches what it needs at the start of the session instead.
data/

__pycache__/
*.pyc
.venv/

# regenerable 1-minute return copy (34MB), rebuilt by scripts/p0_panel.py
runs/2026-09-28_btc-perp-various-free/tables/p0_r1_EXPLORE.parquet

# data-job downloads: the cut copies stay local; CUT.json and SOURCES.md are committed
runs/*/fetched/*/data/

# per-run cached copies of raw TRAIN data (regenerable from data/ by the run's code)
runs/*/work/*.parquet
